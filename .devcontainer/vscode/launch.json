{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bench: Serve",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/apps/frappe/frappe/utils/bench_helper.py",
      "args": [
        "frappe",
        "--site",
        "test-site-dev",
        "serve",
        "--port",
        "8000",
        "--noreload"
      ],
      "python": "${workspaceFolder}/env/bin/python",
      "cwd": "${workspaceFolder}/sites",
      "env": {
        "DEV_SERVER": "1"
      },
      "justMyCode": true
    },
    {
      "name": "Bench: Console",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/apps/frappe/frappe/utils/bench_helper.py",
      "args": ["frappe", "--site", "test-site-dev", "console"],
      "python": "${workspaceFolder}/env/bin/python",
      "cwd": "${workspaceFolder}/sites",
      "console": "integratedTerminal"
    },
    {
      "name": "Bench: Test ask_alyf",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/apps/frappe/frappe/utils/bench_helper.py",
      "args": [
        "frappe",
        "--site",
        "test-site-dev",
        "run-tests",
        "--app",
        "ask_alyf"
      ],
      "python": "${workspaceFolder}/env/bin/python",
      "cwd": "${workspaceFolder}/sites",
      "justMyCode": true
    },
    {
      "name": "Bench: Test module",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/apps/frappe/frappe/utils/bench_helper.py",
      "args": [
        "frappe",
        "--site",
        "test-site-dev",
        "run-tests",
        "--module",
        "${input:testModule}"
      ],
      "python": "${workspaceFolder}/env/bin/python",
      "cwd": "${workspaceFolder}/sites",
      "justMyCode": true
    },
    {
      "name": "Bench: Migrate",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/apps/frappe/frappe/utils/bench_helper.py",
      "args": ["frappe", "--site", "test-site-dev", "migrate"],
      "python": "${workspaceFolder}/env/bin/python",
      "cwd": "${workspaceFolder}/sites"
    },
    {
      "name": "Bench: Worker",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/apps/frappe/frappe/utils/bench_helper.py",
      "args": ["frappe", "worker"],
      "python": "${workspaceFolder}/env/bin/python",
      "cwd": "${workspaceFolder}/sites",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "type": "promptString",
      "id": "testModule",
      "description": "Dotted test module",
      "default": "ask_alyf.ask_alyf.test_api"
    }
  ]
}
